# -----------------------------------------------------------------------------
# AI Provider API Keys
# Get these from their respective platforms.
# -----------------------------------------------------------------------------

# Groq for fast LLM inference (e.g., Llama 3)
VITE_GROQ_API_KEY=

# Hugging Face for access to various models
VITE_HUGGINGFACE_API_KEY=

# OpenRouter for a unified interface to multiple AI models
VITE_OPENROUTER_API_KEY=

# API Ninjas for utility APIs like image-to-text
VITE_APININJA_API_KEY=

# -----------------------------------------------------------------------------
# OAuth Client IDs
# For social sign-in functionality.
# -----------------------------------------------------------------------------

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=

# -----------------------------------------------------------------------------
# Email Service API Key
# Note: Using this directly from the frontend is insecure for production.
# In a real app, this should be handled by a backend service.
# -----------------------------------------------------------------------------

# Resend for sending emails (e.g., 2FA codes, invitations)
VITE_RESEND_API_KEY=